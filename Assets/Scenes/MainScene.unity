  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Tefe\xFCl Nedir?\n\nKelime manas\u0131yla Tefe'\xFCl, fal tutma, fal a\xE7ma,
    hayra yorma ve tevafuklar\u0131 u\u011Furlu sayma anlam\u0131 ta\u015F\u0131r.
    Yabanc\u0131 dilde \"stichomancy\" de denilen Tefe'\xFCl, bir kitab\u0131 rastgele
    a\xE7arak dikkat \xE7eken ve denk gelen ilk yeri okumak, onu \"u\u011Furlu ve
    ders veren bir c\xFCmle saymak\" \u015Feklinde ger\xE7ekle\u015Ftirilir.\n\nHaz\u0131rsan,
    bu sihirli Tefe'\xFCl kitab\u0131n\u0131n bir sonraki sayfas\u0131nda, senin
    i\xE7in rastgele belirmi\u015F birka\xE7 c\xFCmle bulacaks\u0131n. Durma, sayfay\u0131
    \xE7evir!"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 4bd810f1cbcb0f446a8f5a31453e243f, type: 2}
