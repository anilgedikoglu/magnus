  m_Script: {fileID: 11500000, guid: 5e0c62854ba04e2469dfb7ea4953b1a9, type: 3}
  m_Name: SehircevapBursa
  m_EditorClassIdentifier: 
  etiket: sehir cevap
  aciklama:
  - "\"D\xFCnyada bir tek yemek se\xE7eceksin ve onu \xF6mr\xFCn boyunca her g\xFCn
    yiyeceksin\" deseler, bol tereya\u011Fl\u0131 Bursa \u0130skender Kebab\u0131'n\u0131
    se\xE7erdim! :)"
  - "Muradiye K\xFClliyesi, Tophane Saat Kulesi, Ulu Camii, eski Aynal\u0131 \xC7ar\u015F\u0131,
    Uluda\u011F, Tirilye, G\xF6lyaz\u0131... Bursa'da g\xF6r\xFClmesi gereken say\u0131s\u0131z
    yer var. \xD6yle \xF6zel, \xF6yle g\xFCzeldir!"
  aranacakEtiket: saat
  gerekenDegiskenler:
  - degiskenAdi: dogum sehri
    degiskenDegeri: bursa
    kontrolOperatoru: 0
    ayarlamaOperatoru: 0
