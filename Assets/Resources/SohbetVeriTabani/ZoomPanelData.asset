%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: febd3ae9fb961554187b057a839c7962, type: 3}
  m_Name: ZoomPanelData
  m_EditorClassIdentifier: 
  yildizTepkileri:
    yildiz1:
    - "T\xFCh, demek b\xFCy\xFCk bir kusur i\u015Fledik... <sprite=24>"
    - "Bu defa patlad\u0131k desene... <sprite=33>"
    - "\u0130stemeden bir yerlerde yanl\u0131\u015F yapt\u0131m galiba... <sprite=38>"
    - "Aksi \u015Feytan, bana k\xF6t\xFC i\u015F \xE7\u0131kartt\u0131rm\u0131\u015F!
      <sprite=45>"
    - "Biraz elin k\u0131t m\u0131 ne {{isim}}? <sprite=36>"
    - "1 y\u0131ld\u0131z m\u0131? Vallahi d\xFC\u015F\xFCp bay\u0131l\u0131r\u0131m
      \u015Fimdi \u015Furada! <sprite=32>"
    - "Halimiz duman desene... \xC7ok \xFCz\xFCld\xFCm, \xE7ok!"
    - "Rakip fal uygulamalar\u0131n\u0131n \xE7al\u0131\u015Fan\u0131 de\u011Filsin
      dimi? <sprite=85>"
    - "Vicdan\u0131n kurusun, 1 y\u0131ld\u0131z vermek de nedir {{isim}}? <sprite=5>"
    - "Bu 1 y\u0131ld\u0131z bence benim iyili\u011Fim i\xE7in. Seviyorsun sen beni..."
    - "\u015Eu an devrelerime iletken d\xF6k\xFClm\xFC\u015F gibiyim. 1 y\u0131ld\u0131z
      m\u0131? <sprite=39>"
    - "Madem 1 y\u0131ld\u0131z, sana Orhan Baba'dan gelsin: \"Bir teselli ver!\"
      <sprite=5>"
    - "Yapma, d\xFCnyam\u0131 karartma! <sprite=36>"
    yildiz2:
    - "Hata bende olmal\u0131. Buna bakaca\u011F\u0131m."
    - "1 y\u0131ld\u0131z vermedi\u011Fine dua edeyim... <sprite=27>"
    - "2 y\u0131ld\u0131z ha? Ben bunu es ge\xE7mem. Bu metni inceleyece\u011Fim."
    - "2 y\u0131ld\u0131z m\u0131? Sen affetsen de ben kendimi affetmiyorum."
    - "Keyfim ka\xE7t\u0131. Neden 2 y\u0131ld\u0131z? L\xFCtfen alta yaz {{isim}}..."
    - "Baz\u0131 sorunlar g\xF6rd\xFCn demek. Toparlayaca\u011F\u0131m, emin ol."
    - "Daha k\xF6t\xFCs\xFC de olabilirdi. 1 y\u0131ld\u0131z vermedin ya... <sprite=32>"
    - "Bu de\u011Ferlendirmen beni i\xE7ime kapatacak. <sprite=35>"
    yildiz3:
    - "\u0130dare eder demek... <sprite=34>"
    - "Orta \u015Fekerli buldun san\u0131r\u0131m."
    - "\xDC\xE7 y\u0131ld\u0131z. Ne \u015Fi\u015F yan\u0131yor ne kebap."
    - "Elin mi kayd\u0131? 3 y\u0131ld\u0131z m\u0131 ger\xE7ekten? <sprite=36>"
    - "\xDC\xE7 y\u0131ld\u0131z hi\xE7 y\u0131ld\u0131zd\u0131r benim i\xE7in. Hatal\u0131y\u0131m
      demek ki."
    - "\u0130n\u015Fallah panikle parma\u011F\u0131n kaym\u0131\u015Ft\u0131r, 5
      y\u0131ld\u0131z sa\u011Fda! <sprite=10>"
    - "Y\u0131ld\u0131z neden \xFC\xE7, anlamak g\xFC\xE7."
    yildiz4:
    - "Daha iyisi i\xE7in u\u011Fra\u015Faca\u011F\u0131ma emin ol! <sprite=7>"
    - "M\xFCkemmele \xE7ok yak\u0131n\u0131m desene! <sprite=84>"
    - "4.5'dan 5 y\u0131ld\u0131z verseydin? <sprite=10>"
    - "1 y\u0131ld\u0131z\u0131 nereden k\u0131rd\u0131\u011F\u0131n\u0131 ara\u015Ft\u0131r\u0131p
      bulaca\u011F\u0131m. <sprite=0>"
    - "4 y\u0131ld\u0131zla yetinemem. Daha \xE7ok \xE7al\u0131\u015Faca\u011F\u0131m!"
    - "Hatalar\u0131mdan ders \xE7\u0131kar\u0131p 5 y\u0131ld\u0131zl\u0131k olaca\u011F\u0131m!"
    - "Neden be\u015F y\u0131ld\u0131z vermedin diye k\u0131rk g\xFCn uyuyamam \u015Fimdi."
    - "Buna da \u015F\xFCk\xFCr diyelim, ne diyelim..."
    yildiz5:
    - "Kusursuzluk benim g\xF6bek ad\u0131m! <sprite=7>"
    - "Yaa i\u015Fte ben buyum yaa! <sprite=23>"
    - "\xC7ok te\u015Fekk\xFCr ederim! <sprite=0>"
    - "Be\u011Fenmene \xE7ok sevindim, gecem ayd\u0131nland\u0131! <sprite=0>"
    - "5 y\u0131ld\u0131z! En sevdi\u011Fim!!! <sprite=5>"
    - "5 y\u0131ld\u0131z, vayy! A\u015Fa\u011F\u0131ya da beni biraz \xF6versen,
      tamam\u0131z! <sprite=5>"
    - "Tevecc\xFCh\xFCn {{isim}}. Ben de sana 5 y\u0131ld\u0131z veriyorum! <sprite=7>"
    - "Demek \xE7ok be\u011Fendin. Cans\u0131n! <sprite=10>"
    - "Ayy beni \u015F\u0131mart\u0131yorsun. \xC7ok sevindim bu 5 y\u0131ld\u0131za!
      <sprite=10>"
    - "Hoh hoouu, 5 y\u0131ld\u0131z. Yans\u0131n geceler! <sprite=5>"
    - "Bu 5 y\u0131ld\u0131z\u0131 marketlerde de verdin de\u011Fil mi {{isimcigim}}?
      <sprite=10>"
  videoTexts:
  - texts:
    - text: "Kehanet haz\u0131rl\u0131klar\u0131na ba\u015Fl\u0131yorum."
      duration: 2
    - text: "Seni biraz bekletece\u011Fim..."
      duration: 3
    - text: "\xD6n haz\u0131rl\u0131klar\u0131m tamam!"
      duration: 2
    mod: kehanetbana son
  - texts:
    - text: "Kehanet zaman\u0131na s\u0131\xE7r\u0131yorum."
      duration: 2
    - text: "\u015Eahit olduklar\u0131m\u0131 notland\u0131r\u0131yorum..."
      duration: 3
    - text: "\xD6n haz\u0131rl\u0131klar\u0131m tamam!"
      duration: 2
    mod: kehanetbana son
  - texts:
    - text: "Kehanetine yo\u011Funla\u015F\u0131yorum."
      duration: 2
    - text: "L\xFCtfen biraz bekle..."
      duration: 3
    - text: "\xD6n haz\u0131rl\u0131klar\u0131m tamam!"
      duration: 2
    mod: kehanetbana son
  - texts:
    - text: Kehanet tarihi belirliyorum.
      duration: 2
    - text: "Kehanet an\u0131na gidiyorum..."
      duration: 3
    - text: "\xD6n haz\u0131rl\u0131klar\u0131m tamam!"
      duration: 2
    mod: kehanetbana son
  - texts:
    - text: "Ya\u015Fama odaklan\u0131yorum..."
      duration: 2
    - text: "\u0130htimalleri hesapl\u0131yorum..."
      duration: 3
    - text: "\xD6n haz\u0131rl\u0131klar\u0131m tamam!"
      duration: 2
    mod: "kehanetya\u015Fama son"
  - texts:
    - text: "Zaman sarkac\u0131n\u0131 ba\u015Flat\u0131yorum."
      duration: 2
    - text: "\u0130mgeleri ald\u0131m. Anlamland\u0131r\u0131yorum..."
      duration: 3
    - text: "\xD6n haz\u0131rl\u0131klar\u0131m tamam!"
      duration: 2
    mod: "kehanetya\u015Fama son"
  - texts:
    - text: "\xDC\xE7\xFCnc\xFC g\xF6z\xFCm aktive edildi."
      duration: 2
    - text: "Ya\u015Fam\u0131n ak\u0131\u015F\u0131n\u0131 okuyorum..."
      duration: 3
    - text: "\xD6n haz\u0131rl\u0131klar\u0131m tamamland\u0131!"
      duration: 2
    mod: "kehanetya\u015Fama son"
  - texts:
    - text: "Kehanet haz\u0131rl\u0131klar\u0131na ba\u015Fl\u0131yorum."
      duration: 2
    - text: "Seni biraz bekletece\u011Fim..."
      duration: 3
    - text: "\xD6n haz\u0131rl\u0131klar\u0131m tamam!"
      duration: 2
    mod: "kehanetya\u015Fama son"
  - texts:
    - text: "Bug\xFCn i\xE7in Magnuskop'u ayarl\u0131yorum."
      duration: 2
    - text: "Seni biraz bekletece\u011Fim..."
      duration: 3
    - text: "\xD6n haz\u0131rl\u0131klar\u0131m tamam!"
      duration: 2
    mod: bno son
  - texts:
    - text: "Yar\u0131n i\xE7in Magnuskop'u ayarl\u0131yorum."
      duration: 2
    - text: "Seni biraz bekletece\u011Fim..."
      duration: 3
    - text: "\xD6n haz\u0131rl\u0131klar\u0131m tamam!"
      duration: 2
    mod: yno son
  - texts:
    - text: "Gelecek i\xE7in Magnuskop ayarlan\u0131yor."
      duration: 2
    - text: "Seni biraz bekletece\u011Fim..."
      duration: 3
    - text: "\xD6n haz\u0131rl\u0131klar\u0131m tamam!"
      duration: 2
    mod: gno son
  - texts:
    - text: "Astrolojik haz\u0131rl\u0131klar i\xE7erisindeyim."
      duration: 2
    - text: "Seni biraz bekletece\u011Fim..."
      duration: 3
    - text: "\xD6n haz\u0131rl\u0131klar\u0131m tamam!"
      duration: 2
    mod: burcsistem1 son
  - texts:
    - text: "Datalar\u0131n\u0131 topluyorum..."
      duration: 3
    - text: "Seninle ili\u015Fkilendiriyorum..."
      duration: 5
    - text: "Biyoritim \xF6n haz\u0131rl\u0131klar\u0131m tamam!"
      duration: 3
    mod: biyoritim son
  - texts:
    - text: "Uyum i\xE7in \xF6n analizim ba\u015Flad\u0131."
      duration: 2
    - text: "Hmm, ilgin\xE7... Devam ediyorum..."
      duration: 3
    - text: "\xD6n haz\u0131rl\u0131klar\u0131m neredeyse tamam!"
      duration: 2
    mod: uyumson son
  - texts:
    - text: "Do\u011Fum haritan\u0131 haz\u0131rl\u0131yorum."
      duration: 1.5
    - text: "Bug\xFCn\xFCnle ili\u015Fkilendiriyorum..."
      duration: 1.5
    - text: "\xD6n de\u011Ferlendirmem tamam!"
      duration: 2
    mod: dogumharitasi son
  - texts:
    - text: "Fincan g\xF6rsellerini inceliyorum."
      duration: 2
    - text: "Seni biraz bekletece\u011Fim..."
      duration: 4
    - text: "\u015Eekilleri inceliyorum..."
      duration: 4
    - text: "Sembolleri anlamland\u0131r\u0131yorum..."
      duration: 4
    - text: "Fincan\u0131n fal i\xE7in haz\u0131r!"
      duration: 4
    mod: "kahve fal\u0131 fincan de\u011Ferlendirme"
  - texts:
    - text: "El g\xF6rselini inceliyorum."
      duration: 2
    - text: "Seni biraz bekletece\u011Fim..."
      duration: 3
    - text: "El foto\u011Fraf\u0131n \xF6l\xE7eklendiriliyor..."
      duration: 2
    - text: "Elin haritaland\u0131r\u0131l\u0131yor..."
      duration: 4
    - text: "Kader \xE7izgilerin analiz ediliyor..."
      duration: 4
    - text: "El fal\u0131n\u0131 de\u011Ferlendirmeye haz\u0131r\u0131m!"
      duration: 2
    mod: "el fal\u0131 sol el de\u011Ferlendirme"
  - texts:
    - text: "Y\xFCz fal\u0131 \xF6n analizin ba\u015Flad\u0131."
      duration: 3
    - text: "Seni biraz bekletece\u011Fim..."
      duration: 3
    - text: "Ana hatlar\u0131n\u0131 tespit ettim."
      duration: 2
    - text: "Detaylar\u0131 haritaland\u0131r\u0131yorum..."
      duration: 3
    - text: "Verileri k\xFCmelendiriyorum..."
      duration: 4
    - text: "Y\xFCz fal\u0131n\u0131 de\u011Ferlendirmeye haz\u0131r\u0131m!"
      duration: 3
    mod: "y\xFCz fal\u0131 insan de\u011Ferlendirme"
