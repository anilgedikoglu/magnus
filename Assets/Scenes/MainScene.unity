  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Buradan Kahve Fal\u0131n\u0131, Tarot Kartlar\u0131n\u0131, El Fal\u0131n\u0131
    ya da Y\xFCz Fal\u0131n\u0131 yorumlayabilirim. Diledi\u011Fin g\xF6rselleri
    at, akl\u0131ndaki t\xFCm sorular\u0131 sor. Hepsini b\xFCy\xFCk bir \xF6zenle
    cevaplayaca\u011F\u0131m!"
