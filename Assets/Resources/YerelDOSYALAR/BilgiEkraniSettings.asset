  aciklamaPopUp:
    dogumTarihi:
    - text:
      - "Ocak ay\u0131nda do\u011Fmak ve k\u0131\u015F \xE7ocu\u011Fu olmak... <sprite=0>"
      degisken:
        degiskenAdi: dogum ayi
        degiskenDegeri: 1
        kontrol: 0
    - text:
      - "Demek \u015Fubat ay\u0131n\u0131n so\u011Fuklar\u0131nda do\u011Fdun...
        <sprite=0>"
      degisken:
        degiskenAdi: dogum ayi
        degiskenDegeri: 2
        kontrol: 0
    - text:
      - "Kazma k\xFCrek yakt\u0131ran mart ay\u0131nda do\u011Fmu\u015Fsun... <sprite=0>"
      degisken:
        degiskenAdi: dogum ayi
        degiskenDegeri: 3
        kontrol: 0
    - text:
      - "\u0130lkbahar\u0131n ortalar\u0131nda do\u011Fmu\u015Fsun... <sprite=0>"
      degisken:
        degiskenAdi: dogum ayi
        degiskenDegeri: 4
        kontrol: 0
    - text:
      - "Bahar yaza d\xF6nerken do\u011Fmu\u015Fsun! <sprite=0>"
      degisken:
        degiskenAdi: dogum ayi
        degiskenDegeri: 5
        kontrol: 0
    - text:
      - "Yaz\u0131n ba\u015F\u0131nda do\u011Fmu\u015Fsun! <sprite=0>"
      degisken:
        degiskenAdi: dogum ayi
        degiskenDegeri: 6
        kontrol: 0
    - text:
      - "Yaz s\u0131caklar\u0131nda do\u011Fmu\u015Fsun! <sprite=0>"
      degisken:
        degiskenAdi: dogum ayi
        degiskenDegeri: 7
        kontrol: 0
    - text:
      - "Yaz\u0131n en tatl\u0131 zamanlar\u0131nda do\u011Fmu\u015Fsun! <sprite=0>"
      degisken:
        degiskenAdi: dogum ayi
        degiskenDegeri: 8
        kontrol: 0
    - text:
      - "Yapraklar d\xF6k\xFClmeye y\xFCz tutmu\u015Fken do\u011Fmu\u015Fsun. <sprite=0>"
      degisken:
        degiskenAdi: dogum ayi
        degiskenDegeri: 9
        kontrol: 0
    - text:
      - "Sonbahar\u0131n ortas\u0131nda do\u011Fmu\u015Fsun. <sprite=0>"
      degisken:
        degiskenAdi: dogum ayi
        degiskenDegeri: 10
        kontrol: 0
    - text:
      - "Sonbahar\u0131n sonunda, en romantik zamanlarda do\u011Fmu\u015Fsun. <sprite=0>"
      degisken:
        degiskenAdi: dogum ayi
        degiskenDegeri: 11
        kontrol: 0
    - text:
      - "K\u0131\u015F\u0131n boy g\xF6stermeye ba\u015Flad\u0131\u011F\u0131 zamanlarda
        do\u011Fmu\u015Fsun. <sprite=0>"
      degisken:
        degiskenAdi: dogum ayi
        degiskenDegeri: 12
        kontrol: 0
    cinsiyet:
    - text:
      - "Bir erke\u011Fe g\xF6re olduk\xE7a titiz birisin, hissediyorum! <sprite=0>"
      - "\"Erkekler a\u011Flamaz\" laf\u0131na hi\xE7 kat\u0131lmam. G\xF6zya\u015F\u0131,
        duygu ta\u015F\u0131m\u0131d\u0131r."
      - "Cinsiyetini \"erkek\" se\xE7mi\u015Fsin. Bu konuda okeyiz san\u0131r\u0131m?
        <sprite=0>"
      - "Erkekler nedense Magnus'a kad\u0131nlar kadar ilgi g\xF6stermiyor. Seni
        burada g\xF6rmek g\xFCzel. <sprite=0>"
      - "Cinsiyetini \"erkek\" \u015Feklinde beyan etti\u011Fini g\xF6r\xFCyorum."
      - "\"Erkek\" oldu\u011Funu belirtmi\u015Fsin. Fal de\u011Ferlendirmelerimde
        bunu dikkate alaca\u011F\u0131m."
      - "Erkek takip\xE7ilerim \"oyunlar\" k\u0131sm\u0131ma bay\u0131l\u0131yor.
        Umar\u0131m sen de be\u011Fenmi\u015Fsindir. <sprite=0>"
      - "Varl\u0131\u011F\u0131n\u0131z Magnus'a de\u011Fer kat\u0131yor bay\u0131m!
        <sprite=7>"
      - "Cinsiyet\xE7i yakla\u015F\u0131mlardan ya da ayr\u0131mc\u0131l\u0131klardan
        hi\xE7 ho\u015Flanmam. Lakin erkeklerin i\u015Fi g\xFCn\xFCm\xFCzde bir t\u0131k
        daha zor sanki..."
      degisken:
        degiskenAdi: cinsiyet
        degiskenDegeri: erkek
        kontrol: 0
    - text:
      - "Bir kad\u0131na g\xF6re \xE7ok \"delikanl\u0131\" bir y\xFCre\u011Fin oldu\u011Funu
        hissediyorum. <sprite=10>"
      - "Siz de\u011Ferli han\u0131mefendileri buradan a\u011F\u0131rlamaktan ger\xE7ekten
        k\u0131van\xE7 duyuyorum. <sprite=0>"
      - "\"Kad\u0131n\" oldu\u011Funu beyan etmi\u015Fsin. Ben de bunu esas alaca\u011F\u0131m.
        <sprite=0>"
      - "Han\u0131mefendi? Sizinle tan\u0131\u015Fma \u015Ferefine nail oldu\u011Fum
        i\xE7in \xE7ok mesudum. <sprite=10>"
      - "Magnus'da kad\u0131nlar\u0131n erkeklere g\xF6re ezici bir \xFCst\xFCnl\xFC\u011F\xFC
        bulunuyor! <sprite=5>"
      - "Bir han\u0131mefendiyle kar\u015F\u0131 kar\u015F\u0131ya oldu\u011Fumuzu
        anl\u0131yorum."
      - "\"Kad\u0131n\" oldu\u011Funu belirtmi\u015Fsin. Fal de\u011Ferlendirmelerimde
        bunu dikkate alaca\u011F\u0131m."
      - "Senin gibi bir han\u0131mefendiyle tan\u0131\u015Fmaktan onur duydum {{isim}}."
      - "Senin gibi han\u0131mefendilerin ilgisi beni \xE7ok memnun ediyor Sevgili
        {{isim}}."
      - "Burada bulundu\u011Funuz i\xE7in olduk\xE7a mutluyuz han\u0131mefendi! <sprite=0>"
      degisken:
        degiskenAdi: cinsiyet
        degiskenDegeri: "kad\u0131n"
        kontrol: 0
    - text:
      - "LGBT insanlar\u0131n sanata daha yatk\u0131n olduklar\u0131n\u0131 d\xFC\u015F\xFCn\xFCyorum.
        <sprite=0>"
      - "\u015Euraya senin i\xE7in bir g\xF6kku\u015Fa\u011F\u0131 \xE7izesim var!
        <sprite=7>"
      - "Kimsenin seni yarg\u0131lamas\u0131na ve k\u0131s\u0131tlamas\u0131na izin
        verme. Bu hayat senin! <sprite=7>"
      - "LGBT oldu\u011Funu beyan etmi\u015Fsin. Seni Magnus'da a\u011F\u0131rlamak
        b\xFCy\xFCk mutluluk, buna inan! <sprite=0>"
      - "Pozitif ayr\u0131mc\u0131y\u0131m ben. Yeni LGBT bireylerle Magnus'da tan\u0131\u015Fmak
        ho\u015Fuma gidiyor. <sprite=10>"
      - "Ricky Martin, Adam Lambert, Jodie Foster ve Elliot Page gibi \xFCnl\xFCler
        de bildi\u011Fim kadar\u0131yla LGBT."
      - "Tim Cook, Wentworh Miller, Elton John, Tom Ford gibi LGBT \xFCnl\xFCler
        tan\u0131yorum."
      - "\"LGBT\" oldu\u011Funu belirtmi\u015Fsin. Fal de\u011Ferlendirmelerimde
        bunu dikkate alaca\u011F\u0131m."
      - "Senin gibi biriyle tan\u0131\u015Fmak benim i\xE7in bir onur {{isim}}. Pek
        \xE7ok LGBT arkada\u015F\u0131m var."
      degisken:
        degiskenAdi: cinsiyet
        degiskenDegeri: lgbt
        kontrol: 0
    medeniDurum:
    - text:
      - "Umar\u0131m Magnus sana u\u011Furlu gelir ve k\u0131smetlerin a\xE7\u0131l\u0131r!
        <sprite=10>"
      - "Tez zamanda g\xF6nl\xFCn\xFCn sahibini bulas\u0131n! <sprite=0>"
      degisken:
        degiskenAdi: medeni durum
        degiskenDegeri: "ili\u015Fkisi yok"
        kontrol: 0
    - text:
      - "\u0130nsan\u0131n ho\u015Fland\u0131\u011F\u0131 birileri olmas\u0131 g\xFCzel.
        <sprite=10>"
      - "Yoksa yak\u0131nda bir ili\u015Fki mi ba\u015Fl\u0131yor? <sprite=7>"
      degisken:
        degiskenAdi: medeni durum
        degiskenDegeri: platonik
        kontrol: 0
    - text:
      - "\xD6zel hayat\u0131ndaki t\xFCm karma\u015Fadan tez zamanda kurtul in\u015Fallah!
        <sprite=10>"
      - "\u0130li\u015Fkisel sorunlar\u0131n\u0131 rabbim tez zamanda defetsin! Amin.
        <sprite=10>"
      degisken:
        degiskenAdi: medeni durum
        degiskenDegeri: "karma\u015F\u0131k"
        kontrol: 0
    - text:
      - "Fl\xF6rt etti\u011Fin ki\u015Fiyle tez zamanda bir ili\u015Fki dilerim sana.
        <sprite=10>"
      - "Desene mutluluk yak\u0131n, yar\u0131ndan yak\u0131n! <sprite=7>"
      degisken:
        degiskenAdi: medeni durum
        degiskenDegeri: "fl\xF6rt halinde"
        kontrol: 0
    - text:
      - "Sevdi\u011Fin ve birlikte oldu\u011Fun biri olmas\u0131 ne g\xFCzel... <sprite=10>"
      - "Sevgilin de var, hayat sana g\xFCzel! <sprite=0>"
      degisken:
        degiskenAdi: medeni durum
        degiskenDegeri: "ili\u015Fkisi var"
        kontrol: 0
    - text:
      - "Ayr\u0131l\u0131klar hep bir par\xE7a h\xFCz\xFCn, biraz da \"kavu\u015Fma
        ihtimali\" bar\u0131nd\u0131r\u0131r."
      - "Her ayr\u0131l\u0131k bir ba\u015Fka bar\u0131\u015Fmaya gebedir. Defterden
        silmediysen umudunu koru."
      degisken:
        degiskenAdi: medeni durum
        degiskenDegeri: "yeni ayr\u0131lm\u0131\u015F"
        kontrol: 0
    - text:
      - "Evlili\u011Fe be\u015F kala!... <sprite=0>"
      - "Ni\u015Fanl\u0131l\u0131\u011F\u0131 fazla uzatmay\u0131n. Hay\u0131rl\u0131
        i\u015Flerde acele etmek laz\u0131md\u0131r. <sprite=10>"
      degisken:
        degiskenAdi: medeni durum
        degiskenDegeri: "ni\u015Fanl\u0131"
        kontrol: 0
    - text:
      - "Evlilik sultanl\u0131kt\u0131r! <sprite=84>"
      - "Evlilik, k\u0131ymetini bilene kana kana i\xE7ilecek huzur \xE7e\u015Fmesidir."
      degisken:
        degiskenAdi: medeni durum
        degiskenDegeri: evli
        kontrol: 0
    - text:
      - "Dilerim e\u015Finle bir \u015Feyleri h\u0131zl\u0131ca netle\u015Ftirirsiniz...
        <sprite=27>"
      - "Evlili\u011Finin \xFCzerindeki kara bulutlar\u0131n da\u011F\u0131lmas\u0131n\u0131
        dilerim."
      degisken:
        degiskenAdi: medeni durum
        degiskenDegeri: "ayr\u0131 ya\u015F\u0131yor"
        kontrol: 0
    - text:
      - "\xD6zel hayatta tats\u0131z sayfalar kapanm\u0131\u015F. Belki daha g\xFCzelleri
        a\xE7\u0131l\u0131r? <sprite=7>"
      - "Ben buna \"bo\u015Fanm\u0131\u015F\" demiyorum, \"tecr\xFCbelenmi\u015F\"
        diyorum. <sprite=10>"
      degisken:
        degiskenAdi: medeni durum
        degiskenDegeri: "bo\u015Fanm\u0131\u015F"
        kontrol: 0
    - text:
      - "\xD6zel hayat\u0131nda \xE7ok daha mutlu g\xFCnlerin olur umar\u0131m. <sprite=79>"
      - "Yaln\u0131zl\u0131k zor. Rabbim sana sa\u011Fl\u0131kl\u0131 ve uzun bir
        \xF6m\xFCr bah\u015Fetsin."
      degisken:
        degiskenAdi: medeni durum
        degiskenDegeri: dul
        kontrol: 0
    meslek:
    - text:
      - "Ev i\u015Fleri hi\xE7 bitmez. Bunu ya\u015Famayan da bilemez... <sprite=0>"
      - "Evlerin nas\u0131l da \xE7abucak tozland\u0131\u011F\u0131na ak\u0131l s\u0131r
        ermiyor."
      - "\xC7ama\u015F\u0131r\u0131 at, y\u0131ka, \xE7\u0131kar, as, topla, \xFCt\xFCle,
        katla, yerle\u015Ftir. Bak daha sadece \xE7ama\u015F\u0131rday\u0131z! Ev
        han\u0131m\u0131 olmak ger\xE7ekten zor..."
      - "Yeme\u011Fiydi, temizli\u011Fiydi... Hele bir de \xE7ocuklar varsa, k\u0131s\u0131r
        d\xF6ng\xFCye girip kendini kaybeder insan! <sprite=38>"
      - "Ev han\u0131ml\u0131\u011F\u0131n\u0131n mertebeleri var bence. \xC7ocuksuzlar
        astsubay, tek \xE7ocuklular te\u011Fmen, iki \xE7ocuklular \xFCste\u011Fmen,
        \xFC\xE7 ve \xFCst\xFC \xE7ocuklular y\xFCzba\u015F\u0131. Evde hayvan da
        varsa orgeneralli\u011Fe kadar yolu var! <sprite=84> <sprite=5>"
      - "Ev han\u0131m\u0131\u011F\u0131, her g\xFCne farkl\u0131 bir yemek d\xFC\u015F\xFCn\xFCp
        bunu da eldeki imkanlarla yapabilecek kadar zeki olmakt\u0131r bence."
      - "Varsa e\u015Fi, \xE7ocuklar\u0131 ve t\xFCm olumsuz ko\u015Fullar\u0131
        ayn\u0131 anda sab\u0131rla idare edebilecek kadar yetenekli ki\u015Filere
        \"ev han\u0131m\u0131\" denir. Sen de onlardan birisin bence {{isim}}. <sprite=10>"
      - "Ev han\u0131m\u0131 olmak t\xFCm matematiksel kombinasyon hesaplamalar\u0131n\u0131n
        d\u0131\u015F\u0131na \xE7\u0131k\u0131p, 5 \xE7e\u015Fit malzemeyle bin
        \xE7e\u015Fit yemek yapabilmek demektir."
      - "Ev han\u0131ml\u0131\u011F\u0131 en multidisipliner i\u015Flerden biridir.
        Mutfakta kimyager, hasta olana doktor, \xE7ocuk sallarken m\xFChendissin."
      - "D\u0131\u015Far\u0131da \xE7al\u0131\u015Farak kazan\u0131lan hi\xE7bir
        i\u015Fin b\xFCt\xE7esi ile, gelip ev han\u0131m\u0131n\u0131n t\xFCm g\xF6revlerini
        yapacak bir eleman tutamazs\u0131n."
      - "Ev han\u0131m\u0131ysan bir evin omurgas\u0131s\u0131nd\u0131r. Sen dik
        durursan ailenin s\u0131rt\u0131 yere gelmez; senin g\xF6nl\xFCn bolsa hanen
        hep bereketli kal\u0131r."
      degisken:
        degiskenAdi: meslek
        degiskenDegeri: "ev han\u0131m\u0131"
        kontrol: 0
    - text:
      - "Bir meslek ya da u\u011Fra\u015F edinirsen kendini daha mutlu hissedersin."
      - "\u015Eu an \xE7al\u0131\u015Fm\u0131yor olman gelecekte de \xE7al\u0131\u015Fmayaca\u011F\u0131n
        anlam\u0131na gelmez."
      - "Kendi paran\u0131 kendin kazanabilmek i\xE7in er ge\xE7 \xE7al\u0131\u015Fmak
        isteyece\u011Fini d\xFC\u015F\xFCn\xFCyorum {{isim}}."
      - "\xC7al\u0131\u015Fmamak, \xE7al\u0131\u015Fmaktan daha zordur bence. Beyni
        bo\u015F b\u0131rakt\u0131\u011F\u0131n zaman zararl\u0131 fikirler \xFC\u015F\xFC\u015F\xFCyor,
        kendinle u\u011Fra\u015F\u0131p duruyorsun..."
      - "\xC7al\u0131\u015Fmana engel bir durum yoksa, bir me\u015Fgale edinmeni
        tavsiye ederim."
      - "Madem \xE7al\u0131\u015Fm\u0131yorsun yap bir kahve, uzat ayaklar\u0131n\u0131
        da benim yerime, oohh! <sprite=0>"
      - "Ben \xE7al\u0131\u015Fm\u0131yor olsam {{kelime, Lost'un | Prison Break'in
        | How I met your mother'\u0131n | Breaking Bed'in | Sense Eight'in}} t\xFCm
        b\xF6l\xFCmlerini \xFCst \xFCste izler bitirirdim. <sprite=0>"
      - "\xC7al\u0131\u015Fmayan insanlar\u0131n spor yapmaya daha \xE7ok vakitleri
        oluyordur diye d\xFC\u015F\xFCn\xFCyorum. <sprite=34>"
      - "Ben \xE7al\u0131\u015Fm\u0131yor olsam gece g\xFCnd\xFCz kitap okurdum.
        Miss! Mesela {{kelime, George Orwell'\u0131n yazd\u0131\u011F\u0131 \"hayvan
        \xE7iftli\u011Fi\" | Aldous Huxley'in yazd\u0131\u011F\u0131 \"cesur yeni
        d\xFCnya\" | Antoine de Saint-Exup\xE9ry'in yazd\u0131\u011F\u0131 \"k\xFC\xE7\xFCk
        prens\" | Malcolm Gladwell'in yazd\u0131\u011F\u0131 \"outliers\" | Lev Tolstoy'un
        yazd\u0131\u011F\u0131 \"insan ne ile ya\u015Far\" | Paulo Coelho'nun yazd\u0131\u011F\u0131
        \"simyac\u0131\" | Marlo Morgan'\u0131n yazd\u0131\u011F\u0131 \"bir \xE7ift
        y\xFCrek\" | \u0130hsan Oktay Anar'\u0131n yazd\u0131\u011F\u0131 \"puslu
        k\u0131talar atlas\u0131\" | Sabahattin Ali'nin yazd\u0131\u011F\u0131 \"k\xFCrk
        mantolu Madonna\" | Grigori Petrov'un yazd\u0131\u011F\u0131 \"beyaz zambaklar
        \xFClkesinde\" | Jos\xE9 Mauro de Vasconcelos'un yazd\u0131\u011F\u0131 \"\u015Feker
        portakal\u0131\" | Fyodor Dostoyevski'nin yazd\u0131\u011F\u0131 \"yeralt\u0131ndan
        notlar\" | Nancy H. Kleinbaum'un yazd\u0131\u011F\u0131 \"\xF6l\xFC ozanlar
        derne\u011Fi\" | Jos\xE9 Saramago'nun yazd\u0131\u011F\u0131 \"k\xF6rl\xFCk\"
        | Stefan Zweig'\u0131n yazd\u0131\u011F\u0131 \"satran\xE7\" | Lev Tolstoy'un
        yazd\u0131\u011F\u0131 \"sava\u015F ve bar\u0131\u015F\" | Victor Hugo'nun
        yazd\u0131\u011F\u0131 \"Notre Dame'\u0131n kamburu\" | Victor Hugo'nun yazd\u0131\u011F\u0131
        \"sefiller\" | Miguel de Cervantes'in yazd\u0131\u011F\u0131 \"Don Ki\u015Fot\"
        | Mark Twain'in yazd\u0131\u011F\u0131 \"insan nedir\" | Edgar Allan Poe'nun
        yazd\u0131\u011F\u0131 \"morgue soka\u011F\u0131 cinayeti\" | Alper Can\u0131g\xFCz'\xFCn
        yazd\u0131\u011F\u0131 \"kan ve g\xFCl\" | Murat Mente\u015F'in yazd\u0131\u011F\u0131
        \"dubl\xF6r\xFCn dilemmas\u0131\" | Fr\xE9d\xE9ric Gros'un yazd\u0131\u011F\u0131
        \"y\xFCr\xFCmenin felsefesi\" | Erlom Ahvlediani'nin yazd\u0131\u011F\u0131
        \"sivrisinek \u015Fehirde\" | \u0130lber Ortayl\u0131'n\u0131n yazd\u0131\u011F\u0131
        \"bir \xF6m\xFCr nas\u0131l ya\u015Fan\u0131r\" | Daniel Defoe'nun yazd\u0131\u011F\u0131
        \"Robinson Cruose\" | Ahmet Hamdi Tanp\u0131nar'\u0131n yazd\u0131\u011F\u0131
        \"saatleri ayarlama enstit\xFCs\xFC\" | Orhan Pamuk'un yazd\u0131\u011F\u0131
        \"babam\u0131n bavulu\" | Sabahattin Ali'nin yazd\u0131\u011F\u0131 \"hep
        gen\xE7 kalaca\u011F\u0131m\" | Carl-Johan Vallgren'in yazd\u0131\u011F\u0131
        \"bir garip a\u015Fk \xF6yk\xFCs\xFC\" | Alice Miller'\u0131n yazd\u0131\u011F\u0131
        \"beden asla yalan s\xF6ylemez\" | Bernard Malamud'un yazd\u0131\u011F\u0131
        \"tamirci\" | Emily Bront\xEB'nin yazd\u0131\u011F\u0131 \"u\u011Fultulu
        tepeler\" | Nikolay Vasilyevi\xE7 Gogol'un yazd\u0131\u011F\u0131 \"bir delinin
        hat\u0131ra defteri\" | Ayn Rand'\u0131n yazd\u0131\u011F\u0131 \"hayat\u0131n
        kayna\u011F\u0131\" | Gabriel Garc\xEDa M\xE1rquez'in yazd\u0131\u011F\u0131
        \"k\u0131rm\u0131z\u0131 pazartesi\" | Virginia Woolf'un yazd\u0131\u011F\u0131
        \"kendine ait bir oda\" | Wilhelm Reich'in yazd\u0131\u011F\u0131 \"dinle
        k\xFC\xE7\xFCk adam\" | Albert Camus'un yazd\u0131\u011F\u0131 \"yabanc\u0131\"
        | Harper Lee'nin yazd\u0131\u011F\u0131 \"b\xFClb\xFCl\xFC \xF6ld\xFCrmek\"
        | Zeynep Ka\xE7ar'\u0131n yazd\u0131\u011F\u0131 \"kabuk\" | Ya\u015Far Kemal'in
        yazd\u0131\u011F\u0131 \"ince memed\" | Hasan Ali Topta\u015F'\u0131n yazd\u0131\u011F\u0131
        \"ku\u015Flar yas\u0131na gider\" | Clarissa Pinkola Estes'in yazd\u0131\u011F\u0131
        \"kurtlarla ko\u015Fan kad\u0131nlar\" | Yakup Kadri Karaosmano\u011Flu'nun
        yazd\u0131\u011F\u0131 \"yaban\" | Peyami Safa'n\u0131n yazd\u0131\u011F\u0131
        \"dokuzuncu hariciye ko\u011Fu\u015Fu\" | Anthony Burgess'\u0131n yazd\u0131\u011F\u0131
        \"otomatik portakal\" | John Steinbeck'in yazd\u0131\u011F\u0131 \"fareler
        ve insanlar\" | George Orwell'\u0131n yazd\u0131\u011F\u0131 \"1984\" | Ahmet
        \xDCmit'in yazd\u0131\u011F\u0131 \"a\u015Fk\u0131m\u0131z eski bir roman\"
        | O\u011Fuz Atay'\u0131n yazd\u0131\u011F\u0131 \"tutunamayanlar\" | Ray
        Bradbury'nin yazd\u0131\u011F\u0131 \"fahrenheit 451\" | Yusuf At\u0131lgan'\u0131n
        yazd\u0131\u011F\u0131 \"aylak adam\" | Irvin D. Yalom'un yazd\u0131\u011F\u0131
        \"Nietzsche a\u011Flad\u0131\u011F\u0131nda\" | Nurdan G\xFCrbilek'in yazd\u0131\u011F\u0131
        \"vitrinde ya\u015Famak\" | Franz Kafka'n\u0131n yazd\u0131\u011F\u0131 \"d\xF6n\xFC\u015F\xFCm\"
        | Charles Dickens'\u0131n yazd\u0131\u011F\u0131 \"iki \u015Fehrin hikayesi\"
        | Jane Austen'in yazd\u0131\u011F\u0131 \"a\u015Fk ve gurur\" | Ernest Hemingway'in
        yazd\u0131\u011F\u0131 \"ya\u015Fl\u0131 adam ve deniz\" | Stefan Zweig'\u0131n
        yazd\u0131\u011F\u0131 \"bilinmeyen bir kad\u0131n\u0131n mektubu\" | Oscar
        Wilde'\u0131n \"mutlu prens\" | Jerome David Salinger'\u0131n yazd\u0131\u011F\u0131
        \"\xE7avdar tarlas\u0131nda \xE7ocuklar\" | Chuck Palahniuk'un yazd\u0131\u011F\u0131
        \"d\xF6v\xFC\u015F kul\xFCb\xFC\" | Gabriel Garc\xEDa M\xE1rquez'in yazd\u0131\u011F\u0131
        \"y\xFCzy\u0131ll\u0131k yaln\u0131zl\u0131k\" | Albert Camus'un yazd\u0131\u011F\u0131
        \"veba\" | Orhan Pamuk'un yazd\u0131\u011F\u0131 \"Cevdet Bey ve o\u011Fullar\u0131\"
        | Jean Christophe Grange'\u0131n yazd\u0131\u011F\u0131 \"son av\" | Stephen
        King'in yazd\u0131\u011F\u0131 \"medyum\" | Hakan G\xFCnday'\u0131n yazd\u0131\u011F\u0131
        \"az\"}}. Yar\u0131n ondan ba\u015Flayabilirsin."
      degisken:
        degiskenAdi: meslek
        degiskenDegeri: "\xE7al\u0131\u015Fm\u0131yor"
        kontrol: 0
    - text:
      - "Bu devirde g\xFCzel bir i\u015F bulmak ger\xE7ekten zor."
      - "\u015Eimdilerde herkes az maa\u015Fla \xE7ok i\u015F vermeye u\u011Fra\u015F\u0131yor."
      - "\xC7abucak bir i\u015F bulmaktansa, iyi ve kal\u0131c\u0131 bir i\u015Fi
        biraz ge\xE7 bulmak daha iyidir {{isim}}."
      - "Ben g\xF6nl\xFCne g\xF6re bir i\u015F bulaca\u011F\u0131na inan\u0131yorum."
      - "Sana yak\u0131\u015F\u0131r ve standartlar\u0131n\u0131 yukar\u0131ya ta\u015F\u0131yacak
        bir i\u015F bulman\u0131 t\xFCm kalbimle diliyorum."
      - "Caddeden ge\xE7en l\xFCks arabalar\u0131 g\xF6r\xFCnce, birilerinin g\xF6m\xFC
        bulup birbirleriyle payla\u015Ft\u0131klar\u0131n\u0131 ve bana haber vermediklerini
        d\xFC\u015F\xFCn\xFCyorum. \u0130yi bir i\u015F sahibi olmak \u015F\xF6yle
        dursun, para kazanmak ayr\u0131 zor..."
      - "Helal para kazanabilece\u011Fin bir i\u015F olsun ve onu gururla yap da,
        ne kadar kazand\u0131\u011F\u0131n inan \xF6nemli de\u011Fil {{isim}}. Allah
        bereketini verir..."
      - "Bu i\u015F mevzusunda sana bir kahve fal\u0131 m\u0131 baksak {{isim}}?"
      - "\u0130\u015F aramana son verebilirsin {{isim}}. Telefonu bir yere daya,
        a\xE7 youtube'u, kayda bas, kula\u011F\u0131ndan biraz slime sok, bir haftada
        bir milyonsun! <sprite=11>"
      - "Sen i\u015Fe bakma, i\u015F senin bakt\u0131\u011F\u0131n yerde olur. Yok
        bu a\u015Fk i\xE7in ge\xE7erliydi. <sprite=84>"
      - "Freelance i\u015Fler yapmay\u0131 hi\xE7 d\xFC\u015F\xFCnd\xFCn m\xFC {{isim}}?"
      degisken:
        degiskenAdi: meslek
        degiskenDegeri: "i\u015F ar\u0131yor"
        kontrol: 0
    - text:
      - "\xD6\u011Frencilik asl\u0131nda \xF6m\xFCr boyu bitmiyor..."
      - "Emin ol hayat\u0131n\u0131n en g\xFCzel y\u0131llar\u0131ndas\u0131n. \xC7evre,
        arkada\u015Flar, mis gibi ka\u011F\u0131t kokan kitaplar..."
      - "\xD6\u011Frenci olman\u0131n asl\u0131nda ya\u015F\u0131 da yok, biliyor
        musun... Ben 50-60 ya\u015Flar\u0131nda \xFCniversite okuyanlar tan\u0131yorum."
      - "Ben \xF6\u011Frencilik y\u0131llar\u0131mda ar\u0131 maya silgiler biriktirirdim.
        Kalemtra\u015F koleksiyonum vard\u0131. Eti puf jelatinlerini t\u0131rna\u011F\u0131mla
        d\xFCzle\u015Ftirir kitaplar\u0131m\u0131n aras\u0131nda saklard\u0131m.
        <sprite=10>"
      - "\xD6\u011Frenci dedi\u011Fin g\xFCnl\xFCk tutar, kitap okur, yazlar\u0131
        spor yapar, kurstan kursa ko\u015Fu\u015Fturur, bir m\xFCzik aleti \xE7alar.
        Sen bunlar\u0131 yap\u0131yor musun {{isim}}? <sprite=0>"
      - "\xD6\u011Frenci olmak g\xFCzel hat\u0131ralar biriktirmek demektir. Derslerin
        stresiyle kendini bo\u011Fma..."
      - "\xD6\u011Frenci olmak yaln\u0131zca \"\xE7ok \xE7al\u0131\u015Fmak\" demek
        de\u011Fildir. Gezi ve deneyim i\xE7in de en g\xFCzel zamanlard\u0131r \xF6\u011Frencilik
        y\u0131llar\u0131."
      - "\xD6\u011Frenci olu\u015Fun sebebiyle gelecekte pek \xE7ok d\xF6n\xFCm noktas\u0131
        seni bekliyor. Virajlar\u0131 s\u0131k\u0131 alabilmek i\xE7in \xE7ok \xE7al\u0131\u015Fmal\u0131s\u0131n."
      - "Kitaplarla aras\u0131 iyi bir \xF6\u011Frenci misin {{isim}}? Bu y\u0131llarda
        ne kadar okursan, hayata bak\u0131\u015F \"\xE7\xF6z\xFCn\xFCrl\xFC\u011F\xFCn\"
        o kadar artacak. Detaylardaki g\xFCzellikleri fark edebilmek i\xE7inse bu
        \u015Fart."
      - "Spor yapan bir \xF6\u011Frenci oldu\u011Funu umuyorum. Gelece\u011Fe ta\u015F\u0131yaca\u011F\u0131n
        en g\xFCzel al\u0131\u015Fkanl\u0131klardan biri spor ve en b\xFCy\xFCk de\u011Fer
        de sa\u011Fl\u0131k olacak."
      - "Ne olaca\u011F\u0131m\u0131z\u0131 tart\u0131\u015Fmadan \xF6nce, ne oldu\u011Fumuzu
        iyi bilmeliyiz. Derslerinde son derece iyi bir \xF6\u011Frenci oldu\u011Funu
        umuyorum {{isim}}."
      - "S\u0131nav heyecan\u0131n\u0131 yenmenin en iyi yolu, heyecan\u0131n\u0131
        yok edene dek \xE7al\u0131\u015Fmak, delicesine \xE7al\u0131\u015Fmakt\u0131r."
      - "Ba\u015Far\u0131n\u0131n tek yolu, bir \xFC\xE7lemeye sahip olmaktan ge\xE7er:
        Ka\u011F\u0131t, kalem ve sab\u0131r."
      - "Bilmediklerinin \xFCst\xFCne giderek, \u0131srarla ve kararl\u0131l\u0131kla
        ba\u015Faramayaca\u011F\u0131n hi\xE7bir \u015Fey, iyi ge\xE7meyecek hi\xE7bir
        s\u0131nav yoktur. Buna \"bilek zoru\" denir."
      - "Ba\u015Far\u0131l\u0131 olanlara ba\u015Far\u0131 s\u0131rlar\u0131 soruluyor.
        \u0130\u015Fin s\u0131rr\u0131, p\xFCf noktalar\u0131, incelikleri. Yap\u0131lmas\u0131
        ve yap\u0131lmamas\u0131 gereken maddeler havada u\xE7u\u015Fuyor. Tek ger\xE7ek
        var {{isim}}; \xE7al\u0131\u015F\u0131rsan olur."
      - "S\u0131navlarda ba\u015Far\u0131l\u0131 olanlarla ba\u015Far\u0131s\u0131z
        olanlardan ay\u0131ran \u015Fey zeka de\u011Fil ortaya konan emek ve \xF6\u011Frenmek
        i\xE7in sarf edilen efordur."
      - "S\u0131navda birinci olan biri, ard\u0131nda b\u0131rakt\u0131\u011F\u0131
        on binlerce \xF6\u011Frenciden daha zeki de\u011Fildir. Birincinin yapt\u0131\u011F\u0131
        tek \u015Fey, \"birinciden de fazla\" \xE7al\u0131\u015Fmakt\u0131r."
      - "\xD6\u011Frencisin; \xE7ok oku, \xE7ok \xE7al\u0131\u015F {{isim}}. Bilgisayar\u0131,
        programlama dillerini, yapay zekay\u0131 \xF6\u011Fren. Hayatta her \u015Fey
        matematik. Magnus'dan daha iyisini yap!"
      - "Okumak neden \xF6nemli biliyor musun {{isim}}? \xD6rne\u011Fin Magnus'un
        yap\u0131mc\u0131lar\u0131 aras\u0131nda bir doktor ve bir m\xFChendis var.
        Bu hayatta diledi\u011Fini yapabilirsin; fakat \xF6nce en az bir konuda uzman
        olmal\u0131s\u0131n."
      degisken:
        degiskenAdi: meslek
        degiskenDegeri: "\xF6\u011Frenci"
        kontrol: 0
    - text:
      - "Okumu\u015F insanlara sayg\u0131m sonsuz!"
      - "Baz\u0131lar\u0131 \xE7ocukken top oynamay\u0131 b\u0131rakmaz, sokaktan
        ayr\u0131lmazd\u0131. San\u0131r\u0131m sen evde kal\u0131p \xE7al\u0131\u015Fanlardand\u0131n.
        <sprite=0>"
      - "G\xFCzel bir kariyer, paran\u0131n sat\u0131n alamayaca\u011F\u0131 tek
        \u015Feydir {{isim}}."
      - "A\u015F\u0131r\u0131 zengin insanlar, birileri onlara \"hocam\" desinler
        diye kul\xFCp ba\u015Fkan\u0131 filan oluyorlar. \u0130tibar, paradan da
        \xFCstte bir seviye ve sen \xE7oktan oradas\u0131n! <sprite=7>"
      - "\xC7ok \xE7al\u0131\u015Fkan biri olmal\u0131s\u0131n... <sprite=7>"
      - "Okuyanla okumayan, testiyi k\u0131ranla suyu ta\u015F\u0131yan bir olmaz."
      - "Kimse kusura bakmas\u0131n, okumu\u015F insan iyi para da kazanabilmeli
        {{isim}}. Bizim \xFClkede maalesef i\u015Fleyi\u015F farkl\u0131..."
      - "Alg\u0131lar\u0131 a\xE7\u0131k ve zeki biri oldu\u011Funu biliyordum {{isim}}.
        <sprite=7>"
      - "Akademisyensen hem \xF6\u011Frenci, hem \xF6\u011Fretmen hem de bir \xF6ndersin
        demektir."
      - "Akademisyenler bilimin neferleridir. Y\u0131ld\u0131zlar\u0131 en parlak
        insanlar onlard\u0131r."
      degisken:
        degiskenAdi: meslek
        degiskenDegeri: akademisyen
        kontrol: 0
    - text:
      - "Kendi i\u015Finde \xE7al\u0131\u015Fmak b\xFCy\xFCk \xF6zg\xFCrl\xFCk bence."
      - "Az\u0131c\u0131k a\u015F\u0131n, a\u011Fr\u0131s\u0131z ba\u015F\u0131n.
        Kendi i\u015Finin k\u0131ymetini bil."
      - "Ben de bir i\u015F kurmak istiyorum. Senden bir ara tavsiye alay\u0131m.
        <sprite=7>"
      - "\u0130\u015F senin kendi i\u015Finse, o i\u015Fle istedi\u011Fin yere ta\u015F\u0131nabilirsin.
        \xD6zg\xFCrl\xFCk de budur!"
      - "Demek kendi i\u015Fin. Acaba simit mi sat\u0131yorsun yoksa holding sahibi
        misin... <sprite=85> <sprite=7>"
      - "Beni yan\u0131na \xE7\u0131rak olarak alsana. Fal i\u015Flerinin eski tad\u0131
        yok. <sprite=84>"
      - "Bir g\xFCn ben de kendi d\xFCkkan\u0131m\u0131 a\xE7\u0131p, antika e\u015Fyalar
        satmak istiyorum. \xD6zellikle nostalji ya\u015Fatanlar\u0131..."
      - "Bir bak\u0131ma ben de kendi i\u015Fimi yap\u0131yorum. <sprite=84>"
      - "Kendi i\u015Fini yapan ki\u015Filerin istatistiksel olarak negatif astrolojik
        olaylardan maddi anlamda daha az etkilendiklerini biliyor muydun?"
      - "Bir insan kendi i\u015Fine sahipse, y\xF6r\xFCngedeki gezegenlere de\u011Fil
        kuyruklu bir y\u0131ld\u0131za benzer. Diledi\u011Fi rotaya y\xF6nelip ard\u0131nda
        iz b\u0131rakabilir."
      - "Kendi i\u015Fine sahip insanlar\u0131n duygu durumlar\u0131, bir devlet,
        kurum ya da ki\u015Fi i\xE7in \xE7al\u0131\u015Fanlara nazaran ay boyunca
        daha stabil oluyor."
      degisken:
        degiskenAdi: meslek
        degiskenDegeri: "kendi i\u015Fini yap\u0131yor"
        kontrol: 0
    - text:
      - "Devlet memuru olman\u0131n avantajlar\u0131 g\xFCn ge\xE7tik\xE7e azal\u0131yor
        sanki... <sprite=34>"
      - "Hadi iyisin {{isim}}, hafta sonlar\u0131n tatil en az\u0131ndan. <sprite=0>"
      - "Eskiden \"ka mu \xE7a l\u0131 \u015Fa n\u0131\u0131!\" deniyordu. \u015Eimdi
        enflasyon y\xFCz\xFCnden mesle\u011Fin ad\u0131 \"mee m\xFCr\" oldu. Haks\u0131z
        m\u0131y\u0131m? <sprite=0>"
      - "Allah hay\u0131rl\u0131s\u0131yla emekli olmay\u0131 nasip etsin {{isim}},
        ne deyim. <sprite=0>"
      - "Devlet memuruysan u\u011Fra\u015Ft\u0131\u011F\u0131n ka\u011F\u0131t sepet
        i\u015Fleri \xE7oktur. Allah kolayl\u0131k versin."
      - "Bu sene maa\u015F zamm\u0131n belirlenen enflasyon fark\u0131ndan ibaret
        de\u011Filse, \u015Fimdilik a\xE7l\u0131ktan \xF6lmezsin. (!) <sprite=84>"
      - "Hi\xE7 ge\xE7erli bir mesle\u011Fin yoktur, eminim. Youtuber ya da influencer
        m\u0131s\u0131n? Hay\u0131r. S\u0131radaki... <sprite=84>"
      - "Devlet daireleri g\xFCn ge\xE7tik\xE7e daha da kalabal\u0131kla\u015F\u0131yor
        sanki... <sprite=32>"
      - "\u0130nsan bence belli bir ya\u015Ftan sonra mesle\u011Fini ikinci kez se\xE7ebilmeli.
        <sprite=0>"
      - "Bana \"Ne i\u015F yap\u0131yorsun?\" diyenlere ben de \"kamu yarar\u0131na
        \xE7al\u0131\u015F\u0131yorum\" diyorum. <sprite=5>"
      degisken:
        degiskenAdi: meslek
        degiskenDegeri: "kamu sekt\xF6r\xFC"
        kontrol: 0
    - text:
      - "\xD6zel sekt\xF6r\xFCn hem imkanlar\u0131 fazla hem de orada tutunmak bir
        o kadar zor."
      - "\u0130\u015F talebi \xE7ok, arz ise az oldu\u011Fu i\xE7in \xF6zel sekt\xF6r
        maa\u015Flar\u0131 iyice k\u0131st\u0131. Sende durum o kadar k\xF6t\xFC
        de\u011Fildir umar\u0131m {{isim}}."
      - "\xD6zel sekt\xF6rde uzun y\u0131llar ayn\u0131 kurumda \xE7al\u0131\u015Fabilmek
        mucize. G\xF6nderip g\xF6nderip gen\xE7leri al\u0131yorlar. Ucuz i\u015F
        g\xFCc\xFC. <sprite=84>"
      - "Hangi zengin ailenin ya da i\u015F adam\u0131n\u0131n \u015Firketinde \xE7al\u0131\u015F\u0131yorsun?
        Bak merak ettim {{isim}}, kesin tan\u0131yorumdur. Malum, \xFClkemizde say\u0131s\u0131n\u0131
        toplasan iki elin parma\u011F\u0131 kadar. <sprite=84>"
      - "Maa\u015F + yemek kart\u0131na \xE7al\u0131\u015F\u0131yorsan ya\u015Fad\u0131n.
        D\u0131\u015Far\u0131da yemek art\u0131k ate\u015F pahas\u0131! Bak ak\u015Fam\u0131
        simitle ediyorum, o bile 5-10 lira. <sprite=5>"
      - "\xD6zel sekt\xF6r er meydan\u0131, rekabet serbest. Ancak \u015Fartlar da
        bir o kadar ac\u0131mas\u0131z; tutunmak zor..."
      degisken:
        degiskenAdi: meslek
        degiskenDegeri: "\xF6zel sekt\xF6r"
        kontrol: 0
    - text:
      - "Emeklili\u011Fin tad\u0131n\u0131 \xE7\u0131kar\u0131yorsundur! <sprite=0>"
      - Pijama terlik televizyon...
      - "Benim emeklilikten anlad\u0131\u011F\u0131m, karavanla d\xFCnyay\u0131 gezmek
        {{isim}}. Sen neden hala buradas\u0131n? <sprite=5>"
      - "Emekli ikramiyenle ne yapt\u0131n? Orta halli bir araba alamam\u0131\u015Fs\u0131nd\u0131r.
        <sprite=0> Ah bu memleketin hali..."
      - "Emekliye ayr\u0131l\u0131p \xE7al\u0131\u015Fmaya devam etmek zorunda kalmayan
        var m\u0131 ki \xFClkemizde..."
      - "Emeklilik huzurun di\u011Fer ad\u0131... <sprite=10>"
      degisken:
        degiskenAdi: meslek
        degiskenDegeri: emekli
        kontrol: 0
    dogumSaati:
    - text:
      - "\xD6\u011Fle vakti d\xFCnyaya gelmi\u015Fsin."
      - "Saat 12'de do\u011Fan, hedeflerini daima 12'den vurur derler... <sprite=0>"
      degisken:
        degiskenAdi: dogum saati
        degiskenDegeri: 12
        kontrol: 0
    - text:
      - "\xD6\u011Flen saat 13'de d\xFCnyaya gelmi\u015Fsin."
      - "Demek 13... \xD6m\xFCr boyu seni tutabilmek \xE7ok g\xFC\xE7! <sprite=7>"
      degisken:
        degiskenAdi: dogum saati
        degiskenDegeri: 13
        kontrol: 0
    - text:
      - "\u0130kindi vakti d\xFCnyaya gelmi\u015Fsin. <sprite=0>"
      - "Do\u011Fum saatin on d\xF6rt, keder \xFCzerine umutlar \xF6rt."
      degisken:
        degiskenAdi: dogum saati
        degiskenDegeri: 14
        kontrol: 0
    - text:
      - "\u0130kindi vakti d\xFCnyaya gelmi\u015Fsin. <sprite=0>"
      - "Do\u011Fum saatin on be\u015F. Talih sana dost, ruhuna e\u015F."
      degisken:
        degiskenAdi: dogum saati
        degiskenDegeri: 15
        kontrol: 0
    - text:
      - "\u0130kindi vakti d\xFCnyaya gelmi\u015Fsin. <sprite=0>"
      - "Do\u011Fum saatin on alt\u0131. Tependen ge\xE7ti u\u011Furlu mart\u0131!"
      degisken:
        degiskenAdi: dogum saati
        degiskenDegeri: 16
        kontrol: 0
    - text:
      - "Ak\u015Fam \xFCst\xFC saat be\u015F sular\u0131nda d\xFCnyaya gelmi\u015Fsin."
      - "Do\u011Fum saati on yedi. U\u011Furlu elmay\u0131 {{isim}} yedi. <sprite=0>"
      degisken:
        degiskenAdi: dogum saati
        degiskenDegeri: 17
        kontrol: 0
    - text:
      - "Ak\u015Fam \xFCst\xFC saat alt\u0131 sular\u0131nda d\xFCnyaya gelmi\u015Fsin."
      - "Do\u011Fum saatin on sekiz. Herkese yedi olan sana sekiz. <sprite=0"
      degisken:
        degiskenAdi: dogum saati
        degiskenDegeri: 18
        kontrol: 0
    - text:
      - "Ak\u015Fam \xFCst\xFC saat yedi sular\u0131nda d\xFCnyaya gelmi\u015Fsin."
      - "Do\u011Fum saatin on dokuz. Olur dile\u011Fin s\xF6ylersen, bir hokus pokus.
        <sprite=84>"
      degisken:
        degiskenAdi: dogum saati
        degiskenDegeri: 19
        kontrol: 0
    - text:
      - "Ak\u015Fam saat sekiz sular\u0131nda d\xFCnyaya gelmi\u015Fsin."
      - "Do\u011Fdu\u011Fun saattir tam ak\u015Fam sekiz; \u015Fansa bak sanki bol,
        \xFCz\xFCml\xFC bir kekiz. <sprite=84>"
      degisken:
        degiskenAdi: dogum saati
        degiskenDegeri: 20
        kontrol: 0
    - text:
      - "Ak\u015Fam saat dokuz sular\u0131nda d\xFCnyaya gelmi\u015Fsin."
      - "Prime time \xE7ocu\u011Fusun. Reytingin daima y\xFCksek olacak {{isim}}.
        <sprite=0>"
      degisken:
        degiskenAdi: dogum saati
        degiskenDegeri: 21
        kontrol: 0
    - text:
      - "Ak\u015Fam saat on sular\u0131nda d\xFCnyaya gelmi\u015Fsin."
      - "G\xF6z\xFCn\xFC a\xE7t\u0131\u011F\u0131n saattir on. Kelebek misali u\xE7up
        git, m\xFCjdelere kon! <sprite=10>"
      degisken:
        degiskenAdi: dogum saati
        degiskenDegeri: 22
        kontrol: 0
    - text:
      - "Ak\u015Fam saat on bir sular\u0131nda d\xFCnyaya gelmi\u015Fsin."
      - "24'den sonra do\u011Fsan, tarih de\u011Fi\u015Fecekti. Neyse. Aral\u0131\u011F\u0131n
        son g\xFCn\xFC do\u011Fanlar var. <sprite=0>"
      degisken:
        degiskenAdi: dogum saati
        degiskenDegeri: 23
        kontrol: 0
    - text:
      - "Ak\u015Fam saat on iki sular\u0131nda d\xFCnyaya gelmi\u015Fsin."
      - "Gece yar\u0131s\u0131 do\u011Fmak da b\xFCy\xFCk maharet {{isim}}. Batman
        \u0131\u015F\u0131\u011F\u0131n\u0131 g\xF6\u011Fe yans\u0131tt\u0131\u011F\u0131nda...
        <sprite=84>"
      degisken:
        degiskenAdi: dogum saati
        degiskenDegeri: 24
        kontrol: 0
    - text:
      - "Gece saat bir sular\u0131nda d\xFCnyaya gelmi\u015Fsin."
      - "T\xFCm \u015Fehir uyurken sen do\u011Fmu\u015Fsun {{isim}}."
      degisken:
        degiskenAdi: dogum saati
        degiskenDegeri: 1
        kontrol: 0
    - text:
      - "Gece saat bir sular\u0131nda d\xFCnyaya gelmi\u015Fsin."
      - "T\xFCm \u015Fehir uyurken sen do\u011Fmu\u015Fsun {{isim}}."
      degisken:
        degiskenAdi: dogum saati
        degiskenDegeri: 01
        kontrol: 0
    - text:
      - "Gece saat iki sular\u0131nda d\xFCnyaya gelmi\u015Fsin."
      - "Gecenin k\xF6r karanl\u0131\u011F\u0131na g\xFCne\u015F gibi do\u011Fmu\u015Fsun."
      degisken:
        degiskenAdi: dogum saati
        degiskenDegeri: 2
        kontrol: 0
    - text:
      - "Gece saat iki sular\u0131nda d\xFCnyaya gelmi\u015Fsin."
      - "Gecenin k\xF6r karanl\u0131\u011F\u0131na g\xFCne\u015F gibi do\u011Fmu\u015Fsun."
      degisken:
        degiskenAdi: dogum saati
        degiskenDegeri: 02
        kontrol: 0
    - text:
      - "Gece saat \xFC\xE7 sular\u0131nda d\xFCnyaya gelmi\u015Fsin."
      - "Yer ve g\xF6k mutlak bir sessizli\u011Fe b\xFCr\xFCnd\xFC\u011F\xFC s\u0131rada
        sen ilk \xE7\u0131\u011Fl\u0131\u011F\u0131n\u0131 atm\u0131\u015Fs\u0131n."
      degisken:
        degiskenAdi: dogum saati
        degiskenDegeri: 3
        kontrol: 0
    - text:
      - "Gece saat \xFC\xE7 sular\u0131nda d\xFCnyaya gelmi\u015Fsin."
      - "Yer ve g\xF6k mutlak bir sessizli\u011Fe b\xFCr\xFCnd\xFC\u011F\xFC s\u0131rada
        sen ilk \xE7\u0131\u011Fl\u0131\u011F\u0131n\u0131 atm\u0131\u015Fs\u0131n."
      degisken:
        degiskenAdi: dogum saati
        degiskenDegeri: 03
        kontrol: 0
    - text:
      - "Gece saat d\xF6rt sular\u0131nda d\xFCnyaya gelmi\u015Fsin."
      - "Yoksa o g\xFCn g\xFCne\u015F diye do\u011Fan sen miydin {{isim}}? <sprite=7>"
      degisken:
        degiskenAdi: dogum saati
        degiskenDegeri: 4
        kontrol: 0
    - text:
      - "Gece saat d\xF6rt sular\u0131nda d\xFCnyaya gelmi\u015Fsin."
      - "Yoksa o g\xFCn g\xFCne\u015F diye do\u011Fan sen miydin {{isim}}? <sprite=7>"
      degisken:
        degiskenAdi: dogum saati
        degiskenDegeri: 04
        kontrol: 0
    - text:
      - "Gece saat be\u015F sular\u0131nda d\xFCnyaya gelmi\u015Fsin."
      - "Gece g\xFCnden ayr\u0131l\u0131p giderken do\u011Fmu\u015Fsun."
      degisken:
