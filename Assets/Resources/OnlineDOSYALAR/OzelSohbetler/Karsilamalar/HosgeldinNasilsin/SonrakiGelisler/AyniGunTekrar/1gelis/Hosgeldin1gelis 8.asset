  aciklama:
  - "{{isimcigim}} merhaba! Ziyaretin beni \xE7ok mutlu etti.|1|Nas\u0131ls\u0131n?"
  - "{{isimcigim}} merhaba! Gelmene mutlu oldum. <sprite=7> {{saat, G\xFCn\xFCn g\xFCzel
    ge\xE7sin... | G\xFCn\xFCn g\xFCzel ge\xE7sin... | G\xFCn\xFCn g\xFCzel ge\xE7iyordur
    umar\u0131m... | G\xFCn\xFCn g\xFCzel ge\xE7iyordur umar\u0131m... | G\xFCn\xFCn
    g\xFCzel ge\xE7mi\u015Ftir umar\u0131m...}}|1|Nas\u0131ls\u0131n?"
  - "Sevgili {{isim}} ho\u015F geldin! Seni g\xF6r\xFCnce keyfim yerine geliyor.
    <sprite=0>|1|Nas\u0131ls\u0131n?"
  aciklamaBalonuYok: 0
  birlestirilecekModlar: []
  gostermeSansi: 100
  cevaplar:
  - cevapVaryasyonlari:
    - "Gayet iyiyim te\u015Fekk\xFCr ederim."
    - "Olduk\xE7a iyiyim, te\u015Fekk\xFCrler."
    - "Dert \xFCst\xFC murat \xFCst\xFCy\xFCm, sa\u011Folas\u0131n."
    - "Keyfim beyde yok, sa\u011Folas\u0131n."
    - "\u0130yiyim, \xE7ok mersi."
    - "Bug\xFCn\xFCm\xFCze de \u015F\xFCk\xFCr be Magnus..."
    - "\u0130yiyim, sa\u011Fol. "
    - "\u0130yiyim."
    - "\u0130yi diyelim iyi olsun."
    - "Harikay\u0131m."
    - "\u015Eimdilik her \u015Fey okey."
    - "Hi\xE7 fena de\u011Filim."
    - Gayet iyiyim.
    - "Halime bin \u015F\xFCk\xFCr."
    - "\xC7ok iyiyim."
    - "Keyfim yerinde, te\u015Fekk\xFCrler."
