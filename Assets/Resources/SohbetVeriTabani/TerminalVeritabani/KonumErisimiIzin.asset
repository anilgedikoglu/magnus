  m_Script: {fileID: 11500000, guid: 5e0c62854ba04e2469dfb7ea4953b1a9, type: 3}
  m_Name: KonumErisimiIzin
  m_EditorClassIdentifier: 
  etiket: konum izin
  aciklama:
  - "Konum bilgilerine eri\u015Febilir miyim? E\u011Fer buna izin verirsen hangi
    ilde oldu\u011Funu anlayabilir ve de\u011Ferlendirmelerimi ona g\xF6re yapabilirim."
  - "Konum bilgilerine eri\u015Fim rica edebilir miyim? Buna izin vermen seninle
    ilgili daha do\u011Fru de\u011Ferlendirmeler yapabilmem a\xE7\u0131s\u0131ndan
    \xF6nemli."
  - "Seni her konuda daha kapsaml\u0131 bilgilendirebilmek i\xE7in konum verilerine
    eri\u015Fim rica edebilir miyim?"
  - "De\u011Ferlendirmelerimi en kapsaml\u0131 \u015Fekilde yapabilmem i\xE7in konum
    verilerine eri\u015Febilmem gerek. \u0130znin olur mu?"
  aranacakEtiket: sehir
